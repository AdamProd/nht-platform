  "faq": {
    "label": "FAQ",
    "title": "Straight answers.",
    "description": "What creators ask before partnering with NHT.",
    "items": {
      "platforms": {
        "question": "What platforms does NHT manage?",
        "answer": "OnlyFans, Fansly, and ManyVids are our core platforms. We also coordinate traffic from Twitter/X, Instagram, Reddit, and TikTok. As new monetization platforms emerge, we expand with them."
      },
      "fees": {
        "question": "How does NHT structure fees?",
        "answer": "Performance-based. We earn when you earn. After a private consultation, you receive a transparent proposal aligned to your current revenue and trajectory. No retainers. No hidden charges."
      },
      "control": {
        "question": "Do I retain creative control?",
        "answer": "Completely. You own your content, your brand, your decisions. NHT handles operations, strategy, and fan communication. Nothing publishes without your approval."
      },
      "timeline": {
        "question": "How fast do results appear?",
        "answer": "Operational relief is immediate — we take over within days of onboarding. Revenue impact typically surfaces in 30–60 days. Compounding growth follows in months two through six."
      },
      "confidentiality": {
        "question": "How is confidentiality handled?",
        "answer": "Every partnership begins with a signed NDA. We do not disclose client identities, earnings, or account data. Discretion is not a policy here — it is the foundation of how we operate."
      },
      "criteria": {
        "question": "Who is NHT looking for?",
        "answer": "Creators who treat this as a business, not a side project. We work with emerging talent and established earners. Each application is reviewed individually — we accept fewer than we decline."
      }
    }
  },
