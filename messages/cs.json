  "faq": {
    "label": "FAQ",
    "title": "Přímé odpovědi.",
    "description": "Co se tvůrci ptají před partnerstvím s NHT.",
    "items": {
      "platforms": {
        "question": "Jaké platformy NHT spravuje?",
        "answer": "OnlyFans, Fansly a ManyVids jsou naše hlavní platformy. Koordinujeme také traffic z Twitter/X, Instagram, Reddit a TikTok. Jak se objevují nové monetizační platformy, rozšiřujeme se s nimi."
      },
      "fees": {
        "question": "Jak NHT strukturuje poplatky?",
        "answer": "Na bázi výkonu. Vyděláváme, když vyděláváte vy. Po soukromé konzultaci obdržíte transparentní návrh sladěný s vašimi aktuálními tržbami a trajektorií. Žádné retainery. Žádné skryté poplatky."
      },
      "control": {
        "question": "Zachovávám si kreativní kontrolu?",
        "answer": "Zcela. Váš obsah, vaše značka, vaše rozhodnutí. NHT řídí operace, strategii a komunikaci s fanoušky. Nic se nepublikuje bez vašeho souhlasu."
      },
      "timeline": {
        "question": "Jak rychle se objeví výsledky?",
        "answer": "Operační úleva je okamžitá — přebíráme do několika dní po onboardingu. Dopad na tržby se obvykle projeví za 30–60 dní. Kumulativní růst následuje od druhého do šestého měsíce."
      },
      "confidentiality": {
        "question": "Jak je zajištěna důvěrnost?",
        "answer": "Každé partnerství začíná podepsaným NDA. Nezveřejňujeme identity klientů, výdělky ani data účtů. Diskrétnost tu není politika — je to základ naší práce."
      },
      "criteria": {
        "question": "Koho NHT hledá?",
        "answer": "Tvůrce, kteří k tomu přistupují jako k byznysu, ne vedlejšímu projektu. Spolupracujeme s novými talenty i etablovanými tvůrci. Každá přihláška se posuzuje individuálně — přijímáme méně, než odmítáme."
      }
    }
  },
