  "faq": {
    "label": "FAQ",
    "title": "Respuestas directas.",
    "description": "Lo que los creadores preguntan antes de asociarse con NHT.",
    "items": {
      "platforms": {
        "question": "¿Qué plataformas gestiona NHT?",
        "answer": "OnlyFans, Fansly y ManyVids son nuestras plataformas principales. También coordinamos tráfico desde Twitter/X, Instagram, Reddit y TikTok. A medida que surgen nuevas plataformas de monetización, nos expandimos con ellas."
      },
      "fees": {
        "question": "¿Cómo estructura NHT sus honorarios?",
        "answer": "Basados en resultados. Ganamos cuando tú ganas. Tras una consulta privada, recibes una propuesta transparente alineada con tus ingresos actuales y tu trayectoria. Sin retainers. Sin cargos ocultos."
      },
      "control": {
        "question": "¿Conservo el control creativo?",
        "answer": "Por completo. Tu contenido, tu marca, tus decisiones. NHT se encarga de operaciones, estrategia y comunicación con fans. Nada se publica sin tu aprobación."
      },
      "timeline": {
        "question": "¿Qué tan rápido aparecen los resultados?",
        "answer": "El alivio operativo es inmediato — asumimos el control en días tras el onboarding. El impacto en ingresos suele manifestarse en 30–60 días. El crecimiento compuesto llega entre el segundo y el sexto mes."
      },
      "confidentiality": {
        "question": "¿Cómo se maneja la confidencialidad?",
        "answer": "Cada asociación comienza con un NDA firmado. No divulgamos identidades de clientes, ingresos ni datos de cuenta. La discreción no es una política aquí — es la base de cómo operamos."
      },
      "criteria": {
        "question": "¿A quién busca NHT?",
        "answer": "Creadores que lo tratan como un negocio, no como un proyecto secundario. Trabajamos con talento emergente y creadores consolidados. Cada solicitud se revisa de forma individual — aceptamos menos de las que rechazamos."
      }
    }
  },
