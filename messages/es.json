  "services": {
    "label": "Servicios",
    "title": "Management, diseñado con precisión.",
    "description": "Seis disciplinas. Un equipo integrado. Todo lo necesario para gestionar un negocio de creador al más alto nivel.",
    "items": {
      "accountManagement": {
        "title": "Gestión de cuentas",
        "description": "Tus plataformas funcionan sin que estés en la bandeja de entrada. Precios, calendario, optimización del perfil — gestionados a diario por un team lead dedicado."
      },
      "contentStrategy": {
        "title": "Estrategia de contenido",
        "description": "Cada publicación tiene un objetivo. Calendarios basados en datos de rendimiento, señales de tendencia y comportamiento de la audiencia — no en suposiciones."
      },
      "fanEngagement": {
        "title": "Engagement con fans",
        "description": "Mensajes que convierten. Secuencias de retención, outreach personalizado y gestión de conversaciones que mantiene a los suscriptores pagando."
      },
      "revenueArchitecture": {
        "title": "Arquitectura de ingresos",
        "description": "Embudos PPV, estructuras de propinas, lógica de bundles. Diseñamos cómo fluye el dinero por tu cuenta — y lo optimizamos de forma continua."
      },
      "brandPositioning": {
        "title": "Posicionamiento de marca",
        "description": "Cómo te perciben determina lo que ganas. Dirección visual, presencia en redes e identidad cross-platform — ejecutadas con precisión."
      },
      "globalOperations": {
        "title": "Operaciones globales",
        "description": "Equipos en distintos husos horarios. Tus cuentas nunca duermen, nunca pierden una venta ni dejan esperando a un fan de alto valor."
      }
    }
  },
