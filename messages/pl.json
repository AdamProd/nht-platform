  "faq": {
    "label": "FAQ",
    "title": "Bezpośrednie odpowiedzi.",
    "description": "Co twórcy pytają przed partnerstwem z NHT.",
    "items": {
      "platforms": {
        "question": "Jakie platformy obsługuje NHT?",
        "answer": "OnlyFans, Fansly i ManyVids to nasze główne platformy. Koordynujemy też ruch z Twitter/X, Instagram, Reddit i TikTok. W miarę pojawiania się nowych platform monetyzacji rozszerzamy działalność."
      },
      "fees": {
        "question": "Jak NHT strukturyzuje opłaty?",
        "answer": "Oparte na wynikach. Zarabiamy, gdy zarabiasz Ty. Po prywatnej konsultacji otrzymujesz przejrzystą propozycję dopasowaną do Twojego obecnego przychodu i trajektorii. Bez retainerów. Bez ukrytych opłat."
      },
      "control": {
        "question": "Czy zachowuję kontrolę kreatywną?",
        "answer": "W pełni. Twój content, Twoja marka, Twoje decyzje. NHT zajmuje się operacjami, strategią i komunikacją z fanami. Nic nie publikujemy bez Twojej zgody."
      },
      "timeline": {
        "question": "Jak szybko widać wyniki?",
        "answer": "Ulga operacyjna jest natychmiastowa — przejmujemy kontrolę w ciągu kilku dni po onboardingu. Wpływ na przychody zwykle widać w 30–60 dni. Skumulowany wzrost następuje od drugiego do szóstego miesiąca."
      },
      "confidentiality": {
        "question": "Jak zapewniana jest poufność?",
        "answer": "Każde partnerstwo zaczyna się od podpisanego NDA. Nie ujawniamy tożsamości klientów, zarobków ani danych kont. Dyskrecja to nie polityka — to fundament naszej pracy."
      },
      "criteria": {
        "question": "Kogo szuka NHT?",
        "answer": "Twórców, którzy traktują to jak biznes, a nie projekt poboczny. Pracujemy z początkującymi talentami i ugruntowanymi twórcami. Każda aplikacja jest oceniana indywidualnie — akceptujemy mniej, niż odrzucamy."
      }
    }
  },
