  "faq": {
    "label": "FAQ",
    "title": "Klare Antworten.",
    "description": "Was Creators vor einer Partnerschaft mit NHT fragen.",
    "items": {
      "platforms": {
        "question": "Welche Plattformen managed NHT?",
        "answer": "OnlyFans, Fansly und ManyVids sind unsere Kernplattformen. Wir koordinieren auch Traffic von Twitter/X, Instagram, Reddit und TikTok. Wenn neue Monetarisierungsplattformen entstehen, expandieren wir mit."
      },
      "fees": {
        "question": "Wie strukturiert NHT die Gebühren?",
        "answer": "Performance-basiert. Wir verdienen, wenn Sie verdienen. Nach einer privaten Beratung erhalten Sie ein transparentes Angebot, abgestimmt auf Ihren aktuellen Umsatz und Ihre Trajektorie. Keine Retainer. Keine versteckten Kosten."
      },
      "control": {
        "question": "Behalte ich die kreative Kontrolle?",
        "answer": "Vollständig. Ihr Content, Ihre Marke, Ihre Entscheidungen. NHT übernimmt Operations, Strategie und Fan-Kommunikation. Nichts wird ohne Ihre Freigabe veröffentlicht."
      },
      "timeline": {
        "question": "Wie schnell zeigen sich Ergebnisse?",
        "answer": "Operative Entlastung ist sofort — wir übernehmen innerhalb weniger Tage nach dem Onboarding. Umsatzwirkung zeigt sich typischerweise in 30–60 Tagen. Kumulatives Wachstum folgt in Monat zwei bis sechs."
      },
      "confidentiality": {
        "question": "Wie wird Vertraulichkeit gehandhabt?",
        "answer": "Jede Partnerschaft beginnt mit einer unterzeichneten NDA. Wir geben keine Client-Identitäten, Einnahmen oder Account-Daten preis. Diskretion ist hier keine Policy — sie ist die Grundlage unserer Arbeit."
      },
      "criteria": {
        "question": "Wen sucht NHT?",
        "answer": "Creators, die das als Business behandeln, nicht als Nebenprojekt. Wir arbeiten mit aufstrebendem Talent und etablierten Earners. Jede Bewerbung wird individuell geprüft — wir nehmen weniger an, als wir ablehnen."
      }
    }
  },
