  "services": {
    "label": "Leistungen",
    "title": "Management, durchdacht.",
    "description": "Sechs Disziplinen. Ein integriertes Team. Alles, was ein Creator-Business auf höchstem Niveau braucht.",
    "items": {
      "accountManagement": {
        "title": "Account Management",
        "description": "Ihre Plattformen laufen, ohne dass Sie im Posteingang sitzen. Pricing, Scheduling, Profiloptimierung — täglich betreut von einem dedizierten Team Lead."
      },
      "contentStrategy": {
        "title": "Content-Strategie",
        "description": "Jeder Post hat ein Ziel. Kalender basieren auf Performance-Daten, Trend-Signalen und Audience-Verhalten — nicht auf Bauchgefühl."
      },
      "fanEngagement": {
        "title": "Fan Engagement",
        "description": "Nachrichten, die konvertieren. Retention-Sequenzen, personalisierte Ansprache und Conversation Management, das Abonnenten zahlend hält."
      },
      "revenueArchitecture": {
        "title": "Revenue Architecture",
        "description": "PPV-Funnels, Trinkgeld-Strukturen, Bundle-Logik. Wir konstruieren, wie Geld durch Ihren Account fließt — und optimieren kontinuierlich."
      },
      "brandPositioning": {
        "title": "Brand Positioning",
        "description": "Wie Sie wahrgenommen werden, bestimmt, was Sie verdienen. Visuelle Richtung, Social Presence und Cross-Platform-Identität — präzise umgesetzt."
      },
      "globalOperations": {
        "title": "Global Operations",
        "description": "Teams über Zeitzonen hinweg. Ihre Accounts schlafen nie, verpassen keinen Sale und lassen keinen wertvollen Fan warten."
      }
    }
  },
